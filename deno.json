{
  "tasks": {
    "fetch": "deno run --allow-net --allow-read --allow-write src/cli.ts fetch",
    "build": "deno run --allow-read --allow-write src/cli.ts build",
    "test": "deno test --allow-read",
    "send": "deno run --allow-net=127.0.0.1:8765 --allow-read=out tools/send_server.ts",
    "visit": "deno run --allow-read --allow-write --allow-ffi tools/visit_network.ts --affinity 0xFFF5500"
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/cli": "jsr:@std/cli@^1",
    "@std/path": "jsr:@std/path@^1",
    "ajv": "npm:ajv@^8"
  }
}
